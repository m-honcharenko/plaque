{
	"name": "plaque",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"start": "bun src/main.ts",
		"start:dev": "bun --watch src/main.ts",
		"start:prod": "bun dist/main.js",
		"build": "bun build src/main.ts --target bun --packages external --outdir dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware src/ test/ scripts/",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"render:check": "bun scripts/render-check.ts",
		"bench": "bun run build && bun scripts/bench.ts",
		"icons:generate": "bun scripts/gen-icons.ts",
		"fonts:generate": "bun scripts/gen-font-metrics.ts",
		"licenses:generate": "bun scripts/gen-licenses.ts",
		"generate": "bun run icons:generate && bun run fonts:generate && bun run licenses:generate",
		"test": "bun test ./src",
		"test:e2e": "bun test ./test"
	},
	"dependencies": {
		"@fastify/compress": "^9.3.0",
		"@fastify/static": "^10.1.12",
		"@nestjs/common": "^12.5.1",
		"@nestjs/core": "^12.5.1",
		"@nestjs/platform-fastify": "^12.5.1",
		"@nestjs/swagger": "^12.1.2",
		"@nestjs/throttler": "^6.8.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@fontsource/inter": "^5.3.0",
		"@nestjs/cli": "^12.0.13",
		"@nestjs/schematics": "^12.0.13",
		"@nestjs/testing": "^12.5.1",
		"@primer/octicons": "^19.42.0",
		"@types/autocannon": "^7.12.7",
		"@types/bun": "^1.4.4",
		"autocannon": "^9.0.0",
		"opentype.js": "^2.0.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"simple-icons": "^16.38.0",
		"typescript": "^7.0.2"
	}
}
