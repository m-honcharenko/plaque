{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": false,
	"trailingComma": "none",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"singleAttributePerLine": true,
	"sortImports": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		"fixtures",
		"dist",
		"coverage",
		"node_modules",
		"bun.lock",
		"src/core/icons/icons.data.ts",
		"src/core/text/metrics.data.ts"
	]
}
